PORT=4000
# Ruta del archivo SQLite (opcional, por defecto server/portfolio.sqlite)
# DB_PATH=./portfolio.sqlite

# URL exacta de tu frontend en producción (ej: https://burgos.vercel.app).
# La dejás vacía en desarrollo local; en el hosting, ponela para que solo
# tu propio sitio pueda llamar a esta API.
CLIENT_URL=

# Token secreto inventado por vos (cualquier texto largo y random) para
# poder ver los mensajes de contacto guardados en GET /api/messages.
# Sin esto configurado, ese endpoint queda cerrado para todos, vos incluido.
# Ejemplo de uso una vez configurado:
#   curl -H "Authorization: Bearer TU_TOKEN" https://tu-api.com/api/messages
ADMIN_TOKEN=

# ---- Email del formulario de contacto ----
# Sin ninguna de las opciones de abajo, los mensajes se siguen guardando en
# la base de datos, pero NO se envía el email de aviso.

CONTACT_TO_EMAIL=urielburgos333@gmail.com
CONTACT_FROM_EMAIL=

# OPCIÓN 1 (recomendada, más simple): Resend — resend.com
#   1. Crear cuenta gratis en resend.com con tu Gmail (urielburgos333@gmail.com)
#   2. Dashboard > API Keys > Create API Key (permiso "Sending access")
#   3. Pegar la key acá abajo. Como el aviso te llega a VOS MISMO, no hace
#      falta verificar ningún dominio: anda directo.
RESEND_API_KEY=

# OPCIÓN 2: SMTP tradicional (Brevo o Gmail con contraseña de aplicación)
# Se usa solo si RESEND_API_KEY está vacío.
#
# Brevo (ex Sendinblue) - www.brevo.com - 300 emails/día gratis
#   Dashboard > SMTP & API > SMTP > te da host, puerto, usuario y contraseña
#
# Gmail con "Contraseña de aplicación" (necesita verificación en 2 pasos)
#   myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu correo,
#   SMTP_PASS=esa contraseña de 16 letras (no tu contraseña normal de Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
